<style>
  .root {
    flex-direction: column;
    align-items: center;
    padding: 30;
    gap: 14;
    background-color: rgba(5, 2, 15, 0.94);
    border-radius: 16;
    border-color: rgba(0, 255, 100, 0.3);
    border-width: 2;
    width: 320;
  }
  .ghost-icon {
    font-size: 40;
    color: #00ff66;
  }
  .title {
    font-size: 32;
    color: #00ff66;
    font-weight: bold;
  }
  .subtitle {
    font-size: 12;
    color: rgba(0, 255, 100, 0.6);
  }
  .btn {
    padding: 12;
    background-color: rgba(0, 255, 100, 0.12);
    border-radius: 8;
    width: 260;
    align-items: center;
    cursor: pointer;
    border-color: rgba(0, 255, 100, 0.25);
    border-width: 1;
  }
  .btn-text {
    font-size: 16;
